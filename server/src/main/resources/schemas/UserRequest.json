{
    "$id": "https://example.com/user.schema.json",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "user",
    "description": "user request/response",
    "type": "object",
    "properties": {
        "requestType": {
            "description": "the object type should be user",
            "type": "string",
            "pattern": "^user$"
        },
        "action": {
            "description": "the action to perform (e.g., register, login, updateProfile)",
            "type": "string"
        },
        "email": {
            "description": "the email of the user",
            "type": "string"
        },
        "password": {
            "description": "the password of the user",
            "type": "string"
        },
        "userName": {
            "description": "the username of the user",
            "type": "string"
        }
    },
    "required": ["requestType", "action"],
    "additionalProperties": true
}